+    def _server_offset_seconds() -> Optional[int]:
+        """v1.1 helper: broker server time minus UTC, rounded to 30 minutes
+        (brokers use whole/half-hour offsets). MT5 history timestamps are broker
+        server time, not UTC. Estimated from the freshest tick; returns None if no
+        tick is within ~5 minutes of a 30-minute offset."""
+        now_ts = datetime.now(timezone.utc).timestamp()
+        best = None
+        for sym in ("BTCUSDm", "XAUUSDm", "ETHUSDm"):
+            tick = mt5.symbol_info_tick(sym)
+            if tick is None or not getattr(tick, "time", 0):
+                continue
+            raw = float(tick.time) - now_ts
+            off = int(round(raw / 1800.0)) * 1800
+            if abs(raw - off) <= 300 and -14 * 3600 <= off <= 14 * 3600:
+                best = off if best is None else max(best, off)
+        return best
