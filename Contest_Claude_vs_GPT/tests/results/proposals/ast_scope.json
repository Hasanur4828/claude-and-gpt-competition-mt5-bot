      "acc = mt5.account_info()",
      "bal = float(acc.balance) if acc else None",
      "for s in ('BTCUSDm', 'XAUUSDm'):",
      "s_i, tk = (mt5.symbol_info(s), mt5.symbol_info_tick(s))",
      "if not (s_i and tk):",
      "info(f'volume spec {s}', 'symbol/tick পাওয়া যায়নি')",
      "continue",
      "vmin_s = float(s_i.volume_min)",
      "rows = []",
      "for pct in sorted({0.0025, 0.005, 0.01, 0.02, SLTP_PCT}):",
      "loss = mt5.order_calc_profit(mt5.ORDER_TYPE_BUY, s, vmin_s, tk.ask, tk.ask * (1 - pct))",
      "if loss is None:",
      "rows.append(f'SL {pct * 100:.2f}%: order_calc_profit None')",
      "continue",
      "need = abs(float(loss)) / 0.01",
      "rows.append(f\"SL {pct * 100:.2f}%{(' (এই পরীক্ষার SL)' if pct == SLTP_PCT else '')}: min-lot risk ${abs(float(loss)):.2f} → balance ≥ ${need:,.0f} লাগবে\" + ('' if bal is None else ' ✓' if bal >= need else ' ✗ (GPT এই দূরত্বে ট্রেড নেবে না)'))",
      "info(f'volume spec {s}', f\"min {s_i.volume_min}, step {s_i.volume_step}, max {s_i.volume_max}, contract {getattr(s_i, 'trade_contract_size', '?')}, balance {bal} | \" + ' | '.join(rows))"
     ],
